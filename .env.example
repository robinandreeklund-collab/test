# --- GiGi beta test build ---
# The test build runs with an in-memory store and needs NO secrets to boot.
# These are placeholders for when you graduate the test build to real services.

# Port is provided by Render automatically; only set locally if you want.
# PORT=3000

# Anthropic — set this to turn on the real Claude path:
#   • AI bill extraction (Prompt 1) on forwarded email
#   • the voice assistant (/app/voice)
#   • the extraction eval running against Claude (/app/eval)
# Without it, extraction uses the heuristic baseline and voice is disabled.
# ANTHROPIC_API_KEY=

# Anthropic inference region — see docs/DECISIONS.md (§4 / DPIA note).
# Lock inference to EU to keep "EU data only" true. Default eu.
# ANTHROPIC_REGION=eu

# Voice assistant model (defaults to claude-sonnet-5, the repo standard).
# GIGI_ASSISTANT_MODEL=claude-sonnet-5

# Supabase (Postgres) — swap the in-memory store for this when ready.
# See db/schema.sql for the schema.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Default market for new households: uk | se  (see docs/DECISIONS.md §2)
GIGI_DEFAULT_MARKET=uk

# Inbound email webhook (forward feature) — see docs/FORWARDING.md.
# If set, POST /api/inbound requires this as an x-gigi-secret header or
# ?secret= query param, so a public URL can't be spammed.
# INBOUND_SECRET=
