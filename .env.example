# --- GiGi beta test build ---
# The test build runs with an in-memory store and needs NO secrets to boot.
# These are placeholders for when you graduate the test build to real services.

# Port is provided by Render automatically; only set locally if you want.
# PORT=3000

# Anthropic (extraction + digest prompts). Not required for the seeded demo.
# ANTHROPIC_API_KEY=

# Anthropic inference region — see docs/DECISIONS.md (§4 / DPIA note).
# Lock inference to EU to keep "EU data only" true. Default eu.
# ANTHROPIC_REGION=eu

# Supabase (Postgres) — swap the in-memory store for this when ready.
# See db/schema.sql for the schema.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Default market for new households: uk | se  (see docs/DECISIONS.md §2)
GIGI_DEFAULT_MARKET=uk
